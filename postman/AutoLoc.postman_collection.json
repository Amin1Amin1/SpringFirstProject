{
  "info": {
    "_postman_id": "a2bf6e43-bb2e-49f4-8cbf-39e1c92b3bf0",
    "name": "AutoLoc - CRUD API",
    "description": "Scénarios CRUD pour Vehicule, Client et Agence. Lancer les requêtes dans l'ordre, ou exécuter la collection Runner. Variable de base : baseUrl (par défaut http://localhost:8081).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "vehiculeId",
      "value": ""
    },
    {
      "key": "vehiculePlate",
      "value": ""
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "agenceId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Vehicules",
      "item": [
        {
          "name": "GET - Lister les véhicules",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/vehicules"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Réponse HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Le corps est une liste JSON', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - Créer un véhicule",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"immatriculation\": \"{{vehiculePlate}}\",\n  \"marque\": \"Toyota\",\n  \"modele\": \"Yaris\",\n  \"categorie\": \"CITADINE\",\n  \"tarifJournalier\": 85.00,\n  \"statut\": \"DISPONIBLE\"\n}"
            },
            "url": "{{baseUrl}}/api/vehicules"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('vehiculePlate', 'TEST-LOC-' + Date.now().toString().slice(-10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Réponse HTTP 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.expect(body.idVehicule).to.exist;",
                  "pm.collectionVariables.set('vehiculeId', body.idVehicule);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - Consulter le véhicule créé",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/vehicules/{{vehiculeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Réponse HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Identifiant du véhicule conforme', function () { pm.expect(pm.response.json().idVehicule).to.eql(Number(pm.collectionVariables.get('vehiculeId'))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT - Modifier le véhicule créé",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"immatriculation\": \"{{vehiculePlate}}\",\n  \"marque\": \"Toyota\",\n  \"modele\": \"Yaris Hybrid\",\n  \"categorie\": \"CITADINE\",\n  \"tarifJournalier\": 95.00,\n  \"statut\": \"DISPONIBLE\"\n}"
            },
            "url": "{{baseUrl}}/api/vehicules/{{vehiculeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Réponse HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Les changements sont enregistrés', function () { pm.expect(pm.response.json().modele).to.eql('Yaris Hybrid'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE - Supprimer le véhicule créé",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/vehicules/{{vehiculeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Réponse HTTP 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    },
